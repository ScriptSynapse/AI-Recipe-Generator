# Copy this file to .env and fill in real values before running the app.
# .env is loaded by backend/server.js via dotenv, and ANTHROPIC_API_KEY is
# forwarded to the C++ AIGenerator subprocess by backend/services/cppBridge.js.

# Port the Express server listens on.
PORT=3000

# Anthropic API key used by cpp-core/generators/AIGenerator.cpp to call the
# real AI provider (via libcurl -> https://api.anthropic.com/v1/messages).
#
# If this is left blank or unset, AIGenerator automatically falls back to a
# local, offline recipe generator so the application keeps working with no
# AI provider configured (see cpp-core/generators/AIGenerator.cpp).
ANTHROPIC_API_KEY=
