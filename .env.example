# Copy this file to .env and fill in real values. NEVER put real secrets in
# this file -- .env.example is committed to git; .env is git-ignored.
# .env is loaded by backend/server.js via dotenv. Only the variables on the
# allow-list in backend/services/cppBridge.js are forwarded to the C++ engine.

# Port the Express server listens on.
PORT=3000

# Anthropic API key used by the C++ AIGenerator. Leave blank to use the
# offline fallback generator (the app works fine without any key).
ANTHROPIC_API_KEY=

# Optional: override the default Anthropic model without recompiling.
ANTHROPIC_MODEL=

# Optional: max time (ms) Express waits for one C++ engine call. Default 45000.
ENGINE_TIMEOUT_MS=

# --- Additional LLM providers (all optional; each degrades to the next
#     configured provider, then to the offline fallback, if unset or if a
#     call fails) ---

# Google Gemini. Model defaults to gemini-2.5-flash if left blank.
GOOGLE_API_KEY=
GOOGLE_MODEL=

# OpenAI. Model defaults to gpt-4o-mini if left blank.
OPENAI_API_KEY=
OPENAI_MODEL=

# Groq (OpenAI-compatible). Model defaults to llama-3.3-70b-versatile if left blank.
GROQ_API_KEY=
GROQ_MODEL=

# Local / self-hosted OpenAI-compatible server (e.g. Ollama, LM Studio).
# No API key is used. Defaults to http://localhost:11434 and llama3.2.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# --- Authentication (read by the Node server only; NOT forwarded to the C++ engine) ---

# How long a login session lasts, in hours. Default 8.
SESSION_TTL_HOURS=

# Idle timeout in minutes: a session unused for this long ends (default 60, 0 = off).
SESSION_IDLE_MINUTES=

# Set to true when serving over HTTPS: marks the session cookie Secure and
# switches it to the "__Host-" prefixed name. Also enabled automatically
# when NODE_ENV=production.
COOKIE_SECURE=

# --- Rate limiting & API hardening (all optional; values are clamped to safe ranges) ---

# Requests per minute per caller. Anonymous callers are limited by IP,
# logged-in users by account. "GEN" covers the AI endpoints (generate/regenerate).
RATE_API_ANON_PER_MIN=
RATE_API_USER_PER_MIN=
RATE_API_ADMIN_PER_MIN=
RATE_GEN_ANON_PER_MIN=
RATE_GEN_USER_PER_MIN=
RATE_GEN_ADMIN_PER_MIN=

# Login/register requests per minute per IP.
RATE_AUTH_PER_MIN=

# Failed logins allowed per (IP + account) and per IP, per lock window.
LOGIN_MAX_FAILURES=
LOGIN_MAX_FAILURES_PER_IP=
LOGIN_LOCK_MINUTES=

# Comma-separated browser origins allowed to call the API cross-origin, e.g.
# https://app.example.com . Leave EMPTY for same-origin only (the default).
CORS_ORIGINS=

# How many reverse proxies sit in front of this server (0 = none, the default).
# Set this ONLY if you run behind a proxy; otherwise clients could spoof their
# IP with X-Forwarded-For and dodge rate limits.
TRUST_PROXY_HOPS=

# Max JSON request body (default 200kb) and connection timeouts in ms.
JSON_BODY_LIMIT=
REQUEST_TIMEOUT_MS=
HEADERS_TIMEOUT_MS=
KEEPALIVE_TIMEOUT_MS=

# --- AI Model Lab (requests per minute) ---
# One comparison calls EVERY configured provider, so it has its own, much
# lower limit than normal API use. Benchmarks (admin) are lower still.
RATE_COMPARE_USER_PER_MIN=
RATE_COMPARE_ADMIN_PER_MIN=
RATE_BENCHMARK_PER_MIN=
