# Dependencies
node_modules/

# Secrets -- never commit. Copy .env.example to .env locally.
.env
.env.*
!.env.example

# Compiled artifacts (rebuild with `npm run build:cpp`)
cpp-core/recipe_engine
cpp-core/recipe_engine.exe
*.o
*.exe

