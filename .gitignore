data/users.json
data/sessions.json
# the audit log holds client IPs and account activity
data/security-audit.jsonl*
*.lock/
*.tmp
test_*.json

# IDE / OS
.idea/
.vscode/
.DS_Store
*.log
data/model-analytics.json
data/usage.json
